# Leave these empty to run in local demo mode (data stored in the browser).
# Fill both to switch the app to the Supabase adapter.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never prefix with NEXT_PUBLIC_). Used by /api/stage and scripts/upload-stages.mjs
# to sign short-lived URLs for the private image bucket.
SUPABASE_SERVICE_ROLE_KEY=
