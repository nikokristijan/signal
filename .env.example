# Ostavi prazno za lokalni demo način (podaci u pregledniku, simulirani prijatelji).
# Ispuni SVE tri za Supabase (u Vercelu: Project Settings → Environment Variables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SAMO NA SERVERU, nikad s prefiksom NEXT_PUBLIC_. Koristi ga /api/igra/* za upis rezultata.
SUPABASE_SERVICE_ROLE_KEY=
